# PostgreSQL connection for persisted comparisons.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prompt_playground?schema=public"

# Optional for live model responses when the owner/dev runs without a user key.
# With SSO, each user brings their own key (stored encrypted per account); leave empty on production.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Auth. Generate once and keep stable (e.g. `openssl rand -hex 32`).
# ENCRYPTION_KEY encrypts per-user OpenRouter keys at rest (AES-256-GCM).
ENCRYPTION_KEY=""
SESSION_COOKIE_SECRET=""

PORT=5101
