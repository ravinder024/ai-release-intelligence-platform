# PostgreSQL connection for persisted comparisons.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prompt_playground?schema=public"

# Optional for live model responses when the owner/dev runs without a user key.
# With SSO, each user brings their own key (stored encrypted per account); leave empty on production.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Auth. Generate once and keep stable (e.g. `openssl rand -hex 32`).
# ENCRYPTION_KEY encrypts per-user OpenRouter keys at rest (AES-256-GCM).
ENCRYPTION_KEY=""
SESSION_COOKIE_SECRET=""
ADMIN_INITIAL_PASSWORD=""
ALLOW_LOCAL_SIGNUP="false"
ALLOW_LOCAL_LOGIN="false"

# Comma-separated browser origins allowed to send credentialed requests.
ALLOWED_ORIGINS="http://localhost:5101"

# Google OIDC will be enabled in the public deployment after the existing
# Google client is revoked/recreated. Keep all values out of Git.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""

# SMTP is OPTIONAL and is not required for Google sign-in.
# Configure only when email features (reset mail, notifications) are needed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

PORT=5101
