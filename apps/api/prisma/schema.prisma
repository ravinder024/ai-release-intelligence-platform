generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ComparisonStatus {
  running
  completed
  partial_failure
}

enum ExecutionStatus {
  completed
  failed
}

enum ExperimentStatus {
  draft
  running
  completed
  partial_failure
  failed
}

enum ExperimentDecision {
  promote_candidate
  keep_baseline
  continue_experiment
}

enum UserRole {
  user
  admin
}

enum CreditReservationStatus {
  reserved
  consumed
  released
}

model User {
  id                     String   @id @default(uuid()) @db.Uuid
  email                  String   @unique @db.VarChar(255)
  username               String?  @unique @db.VarChar(120)
  passwordHash           String?  @map("password_hash") @db.Text
  displayName            String   @map("display_name") @db.VarChar(120)
  openRouterKeyEncrypted String?  @map("open_router_key_encrypted") @db.Text
  openRouterKeyLast4     String?  @map("open_router_key_last4") @db.VarChar(8)
  openRouterKeyUpdatedAt DateTime? @map("open_router_key_updated_at") @db.Timestamptz(6)
  role                   UserRole @default(user)
  emailVerified          Boolean  @default(false) @map("email_verified")
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities          AuthIdentity[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  promptComparisons   PromptComparison[]
  datasets            Dataset[]
  evaluationRuns      EvaluationRun[]
  experiments         Experiment[]
  creditReservations  EvaluationCreditReservation[]

  @@map("users")
}

model AuthIdentity {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(64)
  issuer            String   @db.VarChar(255)
  subject           String   @db.VarChar(255)
  email             String?  @db.VarChar(255)
  displayName       String?  @map("display_name") @db.VarChar(120)
  emailVerified     Boolean  @default(false) @map("email_verified")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(128)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EvaluationCreditReservation {
  id          String                   @id @default(uuid()) @db.Uuid
  userId      String                   @map("user_id") @db.Uuid
  runId       String?                  @unique @map("run_id") @db.Uuid
  status      CreditReservationStatus  @default(reserved)
  amount      Int                      @default(1)
  reason      String                   @db.VarChar(120)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run         EvaluationRun?           @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("evaluation_credit_reservations")
}

model PromptComparison {
  id          String           @id @default(uuid()) @db.Uuid
  model       String           @db.VarChar(160)
  input       String           @db.Text
  status      ComparisonStatus @default(running)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)
  userId      String?          @map("user_id") @db.Uuid
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions  PromptExecution[]

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("prompt_comparisons")
}

model PromptExecution {
  id                String          @id @default(uuid()) @db.Uuid
  comparisonId      String          @map("comparison_id") @db.Uuid
  variant           String          @db.Char(1)
  prompt            String          @db.Text
  output            String?         @db.Text
  latencyMs         Int?            @map("latency_ms")
  inputTokens       Int?            @map("input_tokens")
  outputTokens      Int?            @map("output_tokens")
  totalTokens       Int?            @map("total_tokens")
  estimatedCostUsd  Decimal?        @map("estimated_cost_usd") @db.Decimal(12, 8)
  status            ExecutionStatus
  errorMessage      String?         @map("error_message") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  comparison        PromptComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, variant])
  @@index([comparisonId])
  @@map("prompt_executions")
}

model Dataset {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(160)
  description String?           @db.Text
  useCase     String?           @db.VarChar(160)
  isSample    Boolean           @default(false)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  userId      String?           @map("user_id") @db.Uuid
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  testCases   DatasetTestCase[]
  runs        EvaluationRun[]
  experiments Experiment[]

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("datasets")
}

model DatasetTestCase {
  id                 String             @id @default(uuid()) @db.Uuid
  datasetId          String             @map("dataset_id") @db.Uuid
  input              String             @db.Text
  expectedOutput     String?            @map("expected_output") @db.Text
  evaluationCriteria Json?              @map("evaluation_criteria")
  notes              String?            @db.Text
  position           Int                @default(0)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  dataset            Dataset            @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results            EvaluationResult[]

  @@index([datasetId, position])
  @@map("dataset_test_cases")
}

model EvaluationRun {
  id                 String            @id @default(uuid()) @db.Uuid
  datasetId          String            @map("dataset_id") @db.Uuid
  model              String            @db.VarChar(160)
  modelA             String?           @map("model_a") @db.VarChar(160)
  modelB             String?           @map("model_b") @db.VarChar(160)
  promptA            String            @map("prompt_a") @db.Text
  promptB            String            @map("prompt_b") @db.Text
  evaluatorModel     String?           @map("evaluator_model") @db.VarChar(160)
  evaluatorThreshold Int?              @map("evaluator_threshold")
  evaluatorPrompt    String?           @map("evaluator_prompt") @db.Text
  status             ComparisonStatus  @default(running)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(6)
  // Optional link to an Experiment (Phase 4)
  experimentId       String?           @map("experiment_id") @db.Uuid
  experiment         Experiment?       @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  userId             String?           @map("user_id") @db.Uuid
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditReservation EvaluationCreditReservation?
  dataset            Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results            EvaluationResult[]

  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("evaluation_runs")
}

model EvaluationResult {
  id                String           @id @default(uuid()) @db.Uuid
  runId             String           @map("run_id") @db.Uuid
  testCaseId        String           @map("test_case_id") @db.Uuid
  variant           String           @db.Char(1)
  prompt            String           @db.Text
  output            String?          @db.Text
  // Snapshot of the provider response for reproducibility
  responseSnapshot  Json?            @map("response_snapshot")
  // Provider/model metadata at time of evaluation
  modelMetadata     Json?            @map("model_metadata")
  // Snapshot of the test case (input/golden/rubric) used at evaluation time
  inputSnapshot           String?  @map("input_snapshot") @db.Text
  expectedOutputSnapshot  String?  @map("expected_output_snapshot") @db.Text
  criteriaSnapshot        Json?    @map("criteria_snapshot")
  latencyMs         Int?             @map("latency_ms")
  inputTokens       Int?             @map("input_tokens")
  outputTokens      Int?             @map("output_tokens")
  totalTokens       Int?             @map("total_tokens")
  estimatedCostUsd  Decimal?         @map("estimated_cost_usd") @db.Decimal(12, 8)
  status            ExecutionStatus
  errorMessage      String?          @map("error_message") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  run               EvaluationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase          DatasetTestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  judgement         EvaluationJudgement?

  @@unique([runId, testCaseId, variant])
  @@index([runId])
  @@index([testCaseId])
  @@map("evaluation_results")
}

model EvaluationJudgement {
  id              String                    @id @default(uuid()) @db.Uuid
  resultId        String                    @map("result_id") @db.Uuid
  overallScore    Int                       @map("overall_score")
  pass            Boolean
  summary         String?                   @db.Text
  evaluatorModel  String?                   @map("evaluator_model") @db.VarChar(160)
  threshold       Int?                      @map("threshold")
  status          ExecutionStatus
  errorMessage    String?                   @map("error_message") @db.Text
  rawOutput       String?                   @map("raw_output") @db.Text
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  result          EvaluationResult          @relation(fields: [resultId], references: [id], onDelete: Cascade)
  criteriaResults EvaluationCriterionResult[]

  @@unique([resultId])
  @@index([resultId])
  @@map("evaluation_judgements")
}

model Experiment {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(160)
  hypothesis         String?            @db.Text
  datasetId          String             @map("dataset_id") @db.Uuid
  baselinePrompt     String             @map("baseline_prompt") @db.Text
  baselineModel      String             @map("baseline_model") @db.VarChar(160)
  candidatePrompt    String             @map("candidate_prompt") @db.Text
  candidateModel     String             @map("candidate_model") @db.VarChar(160)
  evaluatorModel     String?            @map("evaluator_model") @db.VarChar(160)
  evaluatorThreshold Int?               @map("evaluator_threshold")
  evaluatorPrompt    String?            @map("evaluator_prompt") @db.Text
  status             ExperimentStatus   @default(draft)
  decision           ExperimentDecision?
  decisionNote       String?            @map("decision_note") @db.Text
  decidedAt          DateTime?          @map("decided_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Iteration chain (Phase 4 refinement): iteration 1 is the root; "Continue
  // Experiment" creates a child iteration with the previous candidate as baseline.
  iteration          Int                @default(1) @map("iteration")
  parentId           String?            @map("parent_id") @db.Uuid
  parent             Experiment?        @relation("ExperimentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children           Experiment[]       @relation("ExperimentTree")
  dataset            Dataset            @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  userId             String?            @map("user_id") @db.Uuid
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs               EvaluationRun[]

  @@index([createdAt(sort: Desc)])
  @@index([parentId])
  @@index([userId])
  @@map("experiments")
}

model EvaluationCriterionResult {
  id            String             @id @default(uuid()) @db.Uuid
  judgementId   String             @map("judgement_id") @db.Uuid
  criterion     String             @db.Text
  score         Int
  pass          Boolean
  reason        String?            @db.Text
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  judgement     EvaluationJudgement @relation(fields: [judgementId], references: [id], onDelete: Cascade)

  @@index([judgementId])
  @@map("evaluation_criterion_results")
}
