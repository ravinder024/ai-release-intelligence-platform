{
  "name": "ai-release-intelligence-platform",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run build && npm run start",
    "start": "npm run start -w @prompt-playground/api",
    "build": "npm run build -w @prompt-playground/api && npm run build -w @prompt-playground/web",
    "db:generate": "npm run prisma:generate -w @prompt-playground/api",
    "db:migrate": "npm run prisma:migrate -w @prompt-playground/api",
    "db:seed": "npm run db:seed -w @prompt-playground/api",
    "db:prune": "npm run db:prune -w @prompt-playground/api",
    "db:invalidate-sessions": "npm run db:invalidate-sessions -w @prompt-playground/api",
    "db:backfill-ownership": "npm run db:backfill-ownership -w @prompt-playground/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

